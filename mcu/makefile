ARM_GCC =  arm-none-eabi-gcc.exe
ARM_LIB =  arm-none-eabi-ar.exe

HAL_PATH_PERIPHERALS = hal/inc/peripherals/
HAL_PATH_CORE        = hal/inc/core/
HAL_PATH             = hal/inc/

ATSAMD11D14_PACK_INC            = packs/Atmel.SAMD11_DFP.1.1.81/include/

ATSAMD11D14_PERIPHERAL_SOURCES  = atsamd11d14/peripherals/*
ATSAMD11D14_CORE_SOURCES        = atsamd11d14/core/*
ATSAMD11D14_INCLUDES            = packs/Atmel.SAMD11_DFP.1.1.81/include/*
ATSAMD11D14AS                   = __SAMD11D14AS__

CMSIS_5_INC                     = packs/cmsis5/CMSIS/Core/Include

OBJECT_NAME_ATSAMD11D14AS_PERIPH = ATSAMD11D14AS_PERIPH.o
OBJECT_NAME_ATSAMD11D14AS_CORE   = ATSAMD11D14AS_CORE.o
LIB_NAME_ATSAMD11D14AS	         = ATSAMD11D14AS.a

ARCH                             = armv6

atsamd11d14x_peripherals:
	$(ARM_GCC) -I$(HAL_PATH_PERIPHERALS) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AS) -march=$(ARCH) -c $(ATSAMD11D14_PERIPHERAL_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AS_PERIPH)

atsamd11d14x_core:
	$(ARM_GCC) -I$(HAL_PATH_CORE) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AS) -march=$(ARCH) -c $(ATSAMD11D14_CORE_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AS_CORE)

atsamd11d14x_lib: atsamd11d14x_peripherals atsamd11d14x_core
	$(ARM_LIB) -rc $(LIB_NAME_ATSAMD11D14AS) $(OBJECT_NAME_ATSAMD11D14AS_PERIPH) $(OBJECT_NAME_ATSAMD11D14AS_CORE)
	rm *.o