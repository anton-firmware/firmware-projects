ARM_GCC =  arm-none-eabi-gcc.exe
ARM_LIB =  arm-none-eabi-ar.exe

HAL_PATH_PERIPHERALS = hal/inc/peripherals/
HAL_PATH_CORE        = hal/inc/core/
HAL_PATH             = hal/inc/

ATSAMD11D14_PACK_INC             = packs/Atmel.SAMD11_DFP.1.1.81/include/

ATSAMD11D14_PERIPHERAL_SOURCES   = atsamd11d14/peripherals/*
ATSAMD11D14_CORE_SOURCES         = atsamd11d14/core/*
ATSAMD11D14_INCLUDES             = packs/Atmel.SAMD11_DFP.1.1.81/include/*

ATSAMD11D14AS                    = __SAMD11D14AS__
ATSAMD11D14AM                    = __SAMD11D14AM__

CMSIS_5_INC                      = packs/cmsis5/CMSIS/Core/Include

OBJECT_NAME_ATSAMD11D14AS_PERIPH = ATSAMD11D14AS_PERIPH.o
OBJECT_NAME_ATSAMD11D14AS_CORE   = ATSAMD11D14AS_CORE.o
LIB_NAME_ATSAMD11D14AS	         = libATSAMD11D14AS.a

OBJECT_NAME_ATSAMD11D14AM_PERIPH = ATSAMD11D14AM_PERIPH.o
OBJECT_NAME_ATSAMD11D14AM_CORE   = ATSAMD11D14AM_CORE.o
LIB_NAME_ATSAMD11D14AM	         = libATSAMD11D14AM.a

CPU                              = cortex-m0plus
DEBUG_DWARF 					 = dwarf-3
DEBUG_LEVEL						 = 3 

clean:
	rm *.a

atsamd11d14as_peripherals:
	$(ARM_GCC) -I$(HAL_PATH_PERIPHERALS) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AS) -mcpu=$(CPU) -g$(DEBUG_DWARF) -g$(DEBUG_LEVEL) -c $(ATSAMD11D14_PERIPHERAL_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AS_PERIPH)

atsamd11d14as_core:
	$(ARM_GCC) -I$(HAL_PATH_CORE) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AS) -mcpu=$(CPU) -g$(DEBUG_DWARF) -g$(DEBUG_LEVEL) -c $(ATSAMD11D14_CORE_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AS_CORE)

atsamd11d14am_peripherals:
	$(ARM_GCC) -I$(HAL_PATH_PERIPHERALS) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AM) -mcpu=$(CPU) -g$(DEBUG_DWARF) -g$(DEBUG_LEVEL) -c $(ATSAMD11D14_PERIPHERAL_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AM_PERIPH)

atsamd11d14am_core:
	$(ARM_GCC) -I$(HAL_PATH_CORE) -I$(HAL_PATH) -I$(ATSAMD11D14_PACK_INC) -I$(CMSIS_5_INC) -D$(ATSAMD11D14AM) -mcpu=$(CPU) -g$(DEBUG_DWARF) -g$(DEBUG_LEVEL) -c $(ATSAMD11D14_CORE_SOURCES)  -o$(OBJECT_NAME_ATSAMD11D14AM_CORE)

atsamd11d14as_lib: atsamd11d14as_peripherals atsamd11d14as_core
	$(ARM_LIB) -rc $(LIB_NAME_ATSAMD11D14AS) $(OBJECT_NAME_ATSAMD11D14AS_PERIPH) $(OBJECT_NAME_ATSAMD11D14AS_CORE)
	rm *.o

atsamd11d14am_lib: atsamd11d14am_peripherals atsamd11d14am_core
	$(ARM_LIB) -rc $(LIB_NAME_ATSAMD11D14AM) $(OBJECT_NAME_ATSAMD11D14AM_PERIPH) $(OBJECT_NAME_ATSAMD11D14AM_CORE)
	rm *.o

all: atsamd11d14am_lib atsamd11d14as_lib